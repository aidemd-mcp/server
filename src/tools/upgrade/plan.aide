      ```
      case "aide_upgrade": {
        const parsed = UpgradeInput.parse(args);
        const result = await upgrade(root, parsed.confirm, parsed.framework, parsed.path, parsed.skipIde);
        return { content: [{ type: "text", text: result }] };
      }
      ```

