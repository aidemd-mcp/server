{
	"name": "@aidemd-mcp/server",
	"version": "0.3.0",
	"description": "MCP server that teaches any agent the AIDE methodology through tool descriptions and progressive disclosure tooling",
	"type": "module",
	"bin": {
		"aidemd-mcp": "dist/index.js"
	},
	"main": "dist/index.js",
	"scripts": {
		"build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
		"prepublishOnly": "rm -rf dist && npm run build",
		"dev": "tsc --watch",
		"test": "vitest run",
		"export-pdf": "tsx scripts/export-pdf.ts"
	},
	"keywords": [
		"mcp",
		"aide",
		"progressive-disclosure",
		"ai-agents",
		"spec-documents"
	],
	"author": "TetsuKod.ai",
	"repository": {
		"type": "git",
		"url": "https://github.com/aidemd-mcp/server.git"
	},
	"license": "MIT",
	"files": [
		"dist",
		"README.md",
		".aide",
		".aide/bin",
		".claude/commands/aide",
		".claude/agents/aide",
		".claude/skills"
	],
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.12.1",
		"ink": "^7.0.0",
		"react": "^19.2.5",
		"yaml": "^2.8.3",
		"zod": "^3.24.4"
	},
	"devDependencies": {
		"@types/marked": "^6.0.0",
		"@types/node": "^22.15.2",
		"@types/react": "^19.2.14",
		"ink-testing-library": "^4.0.0",
		"marked": "^18.0.0",
		"pdf-lib": "^1.17.1",
		"puppeteer": "^24.40.0",
		"tsc-alias": "^1.8.16",
		"tsx": "^4.21.0",
		"typescript": "^5.8.3",
		"vitest": "^3.1.2"
	}
}
